meta {
  name: 02 - Forzar sincronizacion
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/gestopago/productos/forzar-sincronizacion
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  if (!bru.getVar("catalogoAntes")) {
    throw new Error("Ejecuta Productos antes de sincronizar antes de forzar la descarga.");
  }
}

tests {
  test("Sincroniza sin conflicto de duplicados", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().productos).to.be.an("array").that.is.not.empty;
  });
  test("Catálogo externo con identificadores únicos", function () {
    const productos = res.getBody().productos;
    expect(new Set(productos.map(p => p.idProducto)).size).to.equal(productos.length);
  });
  if (res.getStatus() === 200 && Array.isArray(res.getBody().productos)) {
    bru.setVar("catalogoDescargado", JSON.stringify(res.getBody().productos));
  }
}

docs {
  Consulta realmente GestoPago y guarda su catálogo; requiere credenciales externas configuradas en el backend.
  No lleva body. El Bearer es el JWT local obtenido en Auth/Acceso/Login valido, no el token externo.
  Repetir el ciclo completo para verificar que el segundo guardado también devuelve 200.

  HTTP esperado: 200.
  Autenticación: Bearer token. Renovar el login correspondiente si vence.
  Variables que captura: catalogoDescargado.
  Guía de ejecución: docs/bruno-guia-manual.md.
}
