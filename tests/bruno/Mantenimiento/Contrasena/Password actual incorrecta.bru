meta {
  name: Password actual incorrecta
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/usuarios/{{usuarioMantId}}/password
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{tokenMantenimiento}}
}

body:json {
  {
    "passwordActual": "Incorrecta2026!",
    "passwordNueva": "NuevaPrueba2026!"
  }
}

tests {
  test("HTTP esperado", function () { expect(res.getStatus()).to.equal(401); });
  test("Rechazo controlado", function () { expect(res.getBody().codigo).to.equal("CREDENCIALES_INVALIDAS"); });
}

docs {
  Leer docs/actualizacion-baja-password.md. Usar exclusivamente el perfil QA de mantenimiento.
  La baja va al final y deja ese perfil inactivo; no repetir toda la carpeta tras darlo de baja.

  HTTP esperado: 401.
  Autenticación: Bearer tokenMantenimiento. Renovar el login correspondiente si vence.
  Guía de ejecución: docs/bruno-guia-manual.md.
}
