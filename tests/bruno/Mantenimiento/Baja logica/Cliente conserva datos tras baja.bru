meta {
  name: 02 - Cliente conserva datos tras baja
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/clientes/consultar
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{tokenEjecutivo}}
}

tests {
  test("HTTP esperado", function () { expect(res.getStatus()).to.equal(200); });
  test("Baja lógica", function () { expect(res.getStatus()).to.equal(200); expect(res.getBody().cliente.estatus).to.equal("INACTIVO"); expect(res.getBody().cuentas.every(c => c.estatus === "INACTIVA")).to.equal(true); });
}

docs {
  Leer docs/actualizacion-baja-password.md. Usar exclusivamente el perfil QA de mantenimiento.
  La baja va al final y deja ese perfil inactivo; no repetir toda la carpeta tras darlo de baja.

  HTTP esperado: 200.
  Autenticación: Bearer tokenEjecutivo. Renovar el login correspondiente si vence.
  Guía de ejecución: docs/bruno-guia-manual.md.
}

body:json {
  {
    "id": {{clienteMantId}}
  }
}
