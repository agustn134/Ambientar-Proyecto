meta {
  name: Token alterado
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{tokenAlterado}}
}

script:pre-request {
  const token = bru.getVar("token");
  if (!token) throw new Error("Ejecuta Login valido antes de probar el token alterado");
  const parts = token.split(".");
  parts[2] = (parts[2][0] === "A" ? "B" : "A") + parts[2].slice(1);
  bru.setVar("tokenAlterado", parts.join("."));
}
tests {
  test("HTTP esperado", function () { expect(res.getStatus()).to.equal(401); });
  test("Error controlado", function () { expect(res.getBody()).to.have.property("codigo"); expect(res.getBody()).not.to.have.property("accessToken"); });
}

docs {
  Consultar docs/login-jwt.md antes de ejecutar. Login valido captura el token de Agustin.
  Para bloqueo se usa el perfil sintético de Dulce; repetir Intento incorrecto usuario de bloqueo tres veces.
  El registro de bloqueo sólo crea un usuario la primera vez; repetirlo retorna 409.
}
