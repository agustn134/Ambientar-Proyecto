meta {
  name: Perfil Nancy
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{tokenNancy}}
}

tests {
  test("Perfil CLIENTE propio", function () { expect(res.getStatus()).to.equal(200); expect(res.getBody().correo).to.equal("nancy.guadalupe.enriquez.parra.qa@hotmail.com"); expect(res.getBody().rol).to.equal("CLIENTE"); expect(res.getBody()).not.to.have.property("passwordHash"); });
  if (res.getStatus() === 200) { bru.setVar("nancyClienteId",res.getBody().clienteId); bru.setVar("nancyUsuarioId",res.getBody().usuarioId); }
}

docs {
  Requiere Login Nancy. Confirma el rol CLIENTE y recupera los IDs del perfil sin mostrar contraseña.

  HTTP esperado: 200.
  Autenticación: Bearer tokenNancy. Renovar el login correspondiente si vence.
  Variables que captura: nancyClienteId, nancyUsuarioId.
  Guía de ejecución: docs/bruno-guia-manual.md.
}
