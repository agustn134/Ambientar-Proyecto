meta {
  name: Login Dulce
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "correo": "dulce.maria.lopez.parra.qa@gmail.com",
    "password": "PruebaCliente2026!"
  }
}

tests {
  test("JWT recibido", function () { expect(res.getStatus()).to.equal(200); expect(res.getBody().tokenType).to.equal("Bearer"); });
  if (res.getStatus() === 200) { bru.setVar("tokenDulce", res.getBody().accessToken); bru.setVar("tokenDulceExpiresAt", res.getBody().expiresAt); }
}

docs {
  Primero Registro Dulce una sola vez. Guarda tokenDulce, separado de token y tokenMantenimiento. JWT de 5 minutos; repetir login si vence. Correo de QA propuesto, no confirmado.

  HTTP esperado: 200.
  Autenticación: pública, sin Bearer.
  Variables que captura: tokenDulce, tokenDulceExpiresAt.
  Guía de ejecución: docs/bruno-guia-manual.md.
}
