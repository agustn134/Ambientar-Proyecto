meta {
  name: 01 - Login Sofia
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "correo": "sofia.jimena.salazar.godinez.qa@gmail.com",
    "password": "PruebaCliente2026!"
  }
}

tests {
  test("JWT recibido", function () { expect(res.getStatus()).to.equal(200); expect(res.getBody().tokenType).to.equal("Bearer"); });
  if (res.getStatus() === 200) { bru.setVar("tokenSofia", res.getBody().accessToken); bru.setVar("tokenSofiaExpiresAt", res.getBody().expiresAt); }
}

docs {
  Primero Registro Sofia una sola vez. Guarda tokenSofia, separado de token y tokenMantenimiento. JWT de 5 minutos; repetir login si vence. Correo de QA propuesto, no confirmado.

  HTTP esperado: 200.
  Autenticación: pública, sin Bearer.
  Variables que captura: tokenSofia, tokenSofiaExpiresAt.
  Guía de ejecución: docs/bruno-guia-manual.md.
}
