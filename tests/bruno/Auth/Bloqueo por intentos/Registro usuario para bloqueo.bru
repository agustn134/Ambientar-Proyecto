meta {
  name: 01 - Registro usuario para bloqueo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/clientes
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Dulce",
    "password": "PruebaCliente2026!",
    "apellidoPaterno": "López",
    "apellidoMaterno": "Parra",
    "fechaNacimiento": "2005-11-08",
    "curp": "LOPD051108MGTPRLA8",
    "rfc": "LOPD051108AB1",
    "correoElectronico": "dulce.lopez.parra@example.com",
    "telefonoMovil": "4681046222",
    "domicilio": {
      "calle": "Guerrero",
      "numeroExterior": "843",
      "codigoPostal": "37907",
      "asentamientoId": 110333891,
      "paisId": 1
    },
    "informacionLaboral": {
      "ocupacion": "Gerente de bodega",
      "empresa": "Bodega Aurrera",
      "ingresoMensual": 18000.5
    },
    "segundoNombre": "María",
