meta {
  name: Id de catalogo con tipo incorrecto
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/clientes
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Dulce",
    "password": "PruebaCliente2026!",
    "apellidoPaterno": "López",
    "apellidoMaterno": "Parra",
    "fechaNacimiento": "2005-11-08",
    "curp": "LOPD051108MGTPRLA8",
    "rfc": "LOPD051108AB1",
    "correoElectronico": "dulce.lopez.parra@example.com",
    "telefonoMovil": "4680000000",
    "domicilio": {
      "calle": "Guerrero",
      "numeroExterior": "843",
      "codigoPostal": "37907",
      "asentamientoId": 110333891,
      "paisId": 1
    },
    "informacionLaboral": {
      "ocupacion": "Gerente de bodega",
      "empresa": "Bodega Aurrera",
      "ingresoMensual": 18000.5
    },
    "segundoNombre": "María",
    "sexoId": "2",
    "nacionalidadId": 1,
    "estadoCivilId": 7
  }
}

tests {
  test("Rechaza catálogo inválido", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().codigo).to.equal("JSON_INVALIDO");
    expect(res.getBody().errores.some(e => e.campo === "sexoId")).to.equal(true);
  });
}

docs {
  Error deliberado del perfil de Dulce; no debe persistir cliente, domicilio, cuenta ni usuario.
  Leer docs/catalogos-mexico.md.
}
