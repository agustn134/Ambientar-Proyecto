meta {
  name: Codigo postal
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/catalogos/codigos-postales/37907
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Catálogo disponible", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("array");
    expect(body.some(p => p.id === 110333891 && p.colonia === "San Isidro")).to.equal(true);
  });
}

docs {
  Catálogo público sin datos personales, utilizado antes del registro.
  Consultar docs/catalogos-mexico.md.

  HTTP esperado: 200.
  Autenticación: pública, sin Bearer.
  Guía de ejecución: docs/bruno-guia-manual.md.
}
