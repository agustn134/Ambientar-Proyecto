meta {
  name: 02 - Siguiente pagina ejecutivo
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/clientes?page=1&size=2&ordenarPor=id&direccion=ASC
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{tokenEjecutivo}}
}

script:pre-request {
  if (!bru.getVar("paginaInicialIds")) throw new Error("Ejecuta primero Listado paginado ejecutivo para capturar la primera página.");
}

tests {
  test("Página siguiente sin repetir clientes", function () {
    expect(res.getStatus()).to.equal(200);
    const b=res.getBody();
    const inicial=JSON.parse(bru.getVar("paginaInicialIds"));
    const total=Number(bru.getVar("paginacionTotalElementos"));
    expect(b.page).to.equal(1); expect(b.size).to.equal(2);
    expect(b.totalElementos).to.equal(total); expect(b.totalPaginas).to.equal(Math.ceil(total/2));
    expect(b.contenido).to.have.lengthOf(Math.min(2,Math.max(0,total-2)));
    expect(b.contenido.every((c,i) => inicial.indexOf(c.clienteId) === -1 && (i === 0 || c.clienteId > b.contenido[i-1].clienteId))).to.equal(true);
    if (inicial.length && b.contenido.length) expect(b.contenido[0].clienteId).to.be.greaterThan(inicial[inicial.length-1]);
  });
}

docs {
  HTTP esperado: 200, page 1, size 2, mismos totales y otros IDs. Ejecutar inmediatamente después de Listado paginado ejecutivo, sin registrar o modificar clientes entre ambas peticiones. Puede estar vacía si hay menos de tres clientes.
  Autenticación: Bearer tokenEjecutivo; renovar el login correspondiente si vence.
  Guía: docs/consultas-permisos.md y docs/bruno-guia-manual.md.
}
