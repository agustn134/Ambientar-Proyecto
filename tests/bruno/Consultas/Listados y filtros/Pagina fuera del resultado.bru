meta {
  name: 03 - Pagina fuera del resultado
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/clientes?page={{paginaFueraResultado}}&size=2&ordenarPor=id&direccion=ASC
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{tokenEjecutivo}}
}

script:pre-request {
  if (!bru.getVar("paginaInicialIds")) throw new Error("Ejecuta primero Listado paginado ejecutivo para calcular una página fuera del resultado.");
}

tests {
  test("Página vacía conserva los totales", function () {
    expect(res.getStatus()).to.equal(200);
    const b=res.getBody();
    expect(b.contenido).to.have.lengthOf(0);
    expect(b.page).to.equal(Number(bru.getVar("paginaFueraResultado"))); expect(b.size).to.equal(2);
    expect(b.totalElementos).to.equal(Number(bru.getVar("paginacionTotalElementos")));
    expect(b.totalPaginas).to.equal(Number(bru.getVar("paginaFueraResultado")));
  });
}

docs {
  HTTP esperado: 200, contenido vacío y totales sin cambios. El número de página se toma de totalPaginas de la primera consulta; no se confunde con el caso size 101 inválido.
  Autenticación: Bearer tokenEjecutivo; renovar el login correspondiente si vence.
  Guía: docs/consultas-permisos.md y docs/bruno-guia-manual.md.
}
