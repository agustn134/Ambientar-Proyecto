meta {
  name: 09 - Filtros combinados
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/clientes?correo=agustinlopezparra13%40gmail.com&activo=true
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{tokenEjecutivo}}
}

tests {
  test("HTTP esperado", function () { expect(res.getStatus()).to.equal(200); });
  test("Filtros AND", function () { expect(res.getStatus()).to.equal(200); expect(res.getBody().totalElementos).to.equal(1); expect(res.getBody().contenido[0].correo).to.equal("agustinlopezparra13@gmail.com"); expect(res.getBody().contenido[0].estatus).to.equal("ACTIVO"); });
}

docs {
  Leer docs/consultas-permisos.md y preparar el ejecutivo mediante el script de base de datos.
  CLIENTE usa token; EJECUTIVO usa tokenEjecutivo. Mi cliente captura clienteId y numeroCuenta.

  HTTP esperado: 200.
  Autenticación: Bearer tokenEjecutivo. Renovar el login correspondiente si vence.
  Guía de ejecución: docs/bruno-guia-manual.md.
}
