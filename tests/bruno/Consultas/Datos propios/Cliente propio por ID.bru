meta {
  name: Cliente propio por ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/clientes/{{clienteId}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

tests {
  test("HTTP esperado", function () { expect(res.getStatus()).to.equal(200); });
  test("Identidad propia", function () { expect(res.getBody().cliente.clienteId).to.equal(Number(bru.getVar("clienteId"))); });
}

docs {
  Leer docs/consultas-permisos.md y preparar el ejecutivo mediante el script de base de datos.
  CLIENTE usa token; EJECUTIVO usa tokenEjecutivo. Mi cliente captura clienteId y numeroCuenta.

  HTTP esperado: 200.
  Autenticación: Bearer token. Renovar el login correspondiente si vence.
  Guía de ejecución: docs/bruno-guia-manual.md.
}
