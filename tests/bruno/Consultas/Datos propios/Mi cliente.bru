meta {
  name: 01 - Mi cliente
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/clientes/me
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

tests {
  test("HTTP esperado", function () { expect(res.getStatus()).to.equal(200); });
  test("Detalle propio sin credenciales", function () { expect(res.getBody().cliente.correo).to.equal("agustinlopezparra13@gmail.com"); expect(JSON.stringify(res.getBody())).not.to.include("passwordHash"); });
  if (res.getStatus() === 200) { bru.setVar("clienteId", res.getBody().cliente.clienteId); bru.setVar("numeroCuenta", res.getBody().cuentas[0].numeroCuenta); }
}

docs {
  Leer docs/consultas-permisos.md y preparar el ejecutivo mediante el script de base de datos.
  CLIENTE usa token; EJECUTIVO usa tokenEjecutivo. Mi cliente captura clienteId y numeroCuenta.

  HTTP esperado: 200.
  Autenticación: Bearer token. Renovar el login correspondiente si vence.
  Variables que captura: clienteId, numeroCuenta.
  Guía de ejecución: docs/bruno-guia-manual.md.
}
