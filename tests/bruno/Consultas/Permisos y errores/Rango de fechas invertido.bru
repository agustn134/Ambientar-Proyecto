meta {
  name: 09 - Rango de fechas invertido
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/clientes/listar
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{tokenEjecutivo}}
}

tests {
  test("Rango invertido rechazado", function () { expect(res.getStatus()).to.equal(400); expect((res.getBody().datos ?? res.getBody()).codigo).to.equal("VALIDACION"); });
}

docs {
  HTTP esperado: 400 VALIDACION. Ambas fechas existen, pero desde es posterior a hasta.
  Autenticación: Bearer tokenEjecutivo; renovar el login correspondiente si vence.
  Guía: docs/consultas-permisos.md y docs/bruno-guia-manual.md.
}

body:json {
  {
    "desde": "2026-10-09",
    "hasta": "2026-10-08"
  }
}
