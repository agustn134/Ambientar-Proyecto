meta {
  name: Busqueda inexistente ejecutivo
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/clientes/buscar?correo=no.existe.consulta%40example.com
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{tokenEjecutivo}}
}

tests {
  test("HTTP esperado", function () { expect(res.getStatus()).to.equal(404); });
  test("404 controlado", function () { expect(res.getBody().codigo).to.equal("RECURSO_NO_ENCONTRADO"); });
}

docs {
  Leer docs/consultas-permisos.md y preparar el ejecutivo mediante el script de base de datos.
  CLIENTE usa token; EJECUTIVO usa tokenEjecutivo. Mi cliente captura clienteId y numeroCuenta.

  HTTP esperado: 404.
  Autenticación: Bearer tokenEjecutivo. Renovar el login correspondiente si vence.
  Guía de ejecución: docs/bruno-guia-manual.md.
}
