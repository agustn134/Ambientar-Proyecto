meta {
  name: 05 - Listado denegado a cliente
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/clientes/listar
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

tests {
  test("HTTP esperado", function () { expect(res.getStatus()).to.equal(403); });
  test("Permiso denegado", function () { expect((res.getBody().datos ?? res.getBody()).codigo).to.equal("ACCESO_DENEGADO"); });
}

docs {
  Leer docs/consultas-permisos.md y preparar el ejecutivo mediante el script de base de datos.
  CLIENTE usa token; EJECUTIVO usa tokenEjecutivo. Mi cliente captura clienteId y numeroCuenta.

  HTTP esperado: 403.
  Autenticación: Bearer token. Renovar el login correspondiente si vence.
  Guía de ejecución: docs/bruno-guia-manual.md.
}

body:json {
  {}
}
