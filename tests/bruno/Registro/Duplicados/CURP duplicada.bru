meta {
  name: 01 - CURP duplicada
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/clientes
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Dulce",
    "password": "PruebaCliente2026!",
    "apellidoPaterno": "López",
    "apellidoMaterno": "Parra",
    "fechaNacimiento": "2005-11-08",
    "curp": "LOPA040905HGTPRGA7",
    "rfc": "LOPD051108AB1",
    "correoElectronico": "dulce.lopez.parra@example.com",
    "telefonoMovil": "4681046222",
    "domicilio": {
      "calle": "Guerrero",
      "numeroExterior": "843",
      "codigoPostal": "37907",
      "asentamientoId": 110333891,
      "paisId": 1
    },
    "informacionLaboral": {
      "ocupacion": "Gerente de bodega",
      "empresa": "Bodega Aurrera",
      "ingresoMensual": 18000.5
    },
    "segundoNombre": "María",
    "sexoId": 2,
    "nacionalidadId": 1,
    "estadoCivilId": 7
  }
}

tests {
  test("HTTP esperado", function () { expect(res.getStatus()).to.equal(409); });
  test("Campo rechazado", function () { expect(res.getBody().errores.map(e => e.campo)).to.include("curp"); });
}

docs {
  Consultar docs/datos-prueba.md y docs/registro-clientes.md. Los casos de duplicados requieren ejecutar primero Registro valido.
  El registro válido crea datos; al repetirlo sin cambiarlos se espera 409.

  HTTP esperado: 409.
  Autenticación: pública, sin Bearer.
  Guía de ejecución: docs/bruno-guia-manual.md.
}
